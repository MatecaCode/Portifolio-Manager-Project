# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (via *.local) — never commit real keys.
#
# Anything prefixed VITE_ is compiled into the browser bundle and is therefore
# PUBLIC. Treat every value here as readable by anyone who visits the site.
# That is fine for the Supabase anon key (RLS is what protects the data — see
# supabase_security.sql) but it means the price-API keys below are shared
# secrets at best. Restrict them by domain in each provider's dashboard where
# the plan allows it, and rotate them if they ever leak.

# ── Supabase (shared portfolio + budget data between you & Melanie) ─────────
# Settings → API. The anon/publishable key, NOT the service_role key —
# service_role bypasses RLS and must never appear in frontend code.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Finnhub (US stocks: CEG, VRT, BE) ───────────────────────────────────────
# finnhub.io/dashboard
VITE_FINNHUB_KEY=your_finnhub_key_here

# ── Brapi (BR stocks + FIIs: PRIO3, XPML11, etc.) ──────────────────────────
# brapi.dev
VITE_BRAPI_KEY=your_brapi_key_here

# ── CoinGecko (Crypto: BTC, ETH, XRP, BNB, AVAX) ───────────────────────────
# Free tier — no key needed.
